#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";
            // -----------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |  Z  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |
            // |  Y  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |
            //             | SHFT | LWR | SPC | ENT | RSE | BSPC |
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T   &kp Z &kp U  &kp I     &kp O   &kp P
                &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI
                &kp Y &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH
                            &kp LSHFT &mo 1 &kp SPACE   &kp RET &mo 2 &kp BSPC
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            // -----------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5    |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5   | LFT | DWN |  UP | RGT | TAB |
            // | BTCR| RGB | RST | BOOT| Unlock| GUI | ALT |     |     | ESC |
            //                    |     |     |     |     |     |     |
            bindings = <
                &kp N1       &kp N2          &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0
                &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp TAB
                &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock &kp LGUI &kp LALT &trans &trans    &kp ESC
                                                           &trans       &trans       &trans   &trans   &trans &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // -----------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |  ^  |  &  |  *  |  (  |  )  |
            // | HUD | HUI | CTRL|     |     |  -  |  =  |  [  |  ]  |  \  |
            // |     |  `  |  '  |  ~  |     |  _  |  +  |  {  |  }  | "|" |
            //                    |     |     |     |     |     |     |
            bindings = <
                &kp EXCL        &kp AT          &kp HASH   &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR
                &rgb_ug RGB_HUD &rgb_ug RGB_HUI &kp LCTRL  &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH
                &trans          &kp GRAVE       &kp SQT    &kp TILDE &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE
                                                            &trans   &trans     &trans    &trans    &trans   &trans
            >;
        };
    };
};
